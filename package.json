{
  "private": true,
  "scripts": {
    "clean": "node -e \"for (const p of ['output', '.spago']) require('node:fs').rmSync(p, { recursive: true, force: true })\"",
    "build": "spago build --pedantic-packages --strict",
    "format": "purs-tidy format-in-place 'src/**/*.purs'",
    "format:check": "purs-tidy check 'src/**/*.purs'"
  },
  "devDependencies": {
    "purs-tidy": "0.11.1",
    "purescript": "0.15.16",
    "spago": "1.0.4"
  }
}
